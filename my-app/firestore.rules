rules_version = '2';

// Dữ liệu nằm dưới nhánh của từng user:
//   users/{uid}/books/{bookId}
//   users/{uid}/categories/{categoryId}
// → chỉ đọc/ghi được dưới nhánh của chính mình.
// Mọi đường dẫn khác (collection cũ books/categories, ...) bị chặn mặc định.
// Deploy: firebase deploy --only firestore:rules
// (hoặc paste nội dung này vào Firebase Console → Firestore → Rules → Publish)
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
